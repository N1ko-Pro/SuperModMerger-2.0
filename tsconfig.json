{
 "compilerOptions": {
 "target": "ES2021",
 "module": "ESNext",
 "moduleResolution": "bundler",
 "lib": ["ES2021"],
 "noEmit": true,
 "strict": true,
 "esModuleInterop": true,
 "skipLibCheck": true,
 "resolveJsonModule": true,
 "forceConsistentCasingInFileNames": true
 },
 "include": ["electron/**/*.ts", "src/**/*.ts"],
 "exclude": ["node_modules", "dist", "renderer"]
}
